{
    "name": "Faraway - Scores & Détecteur IA",
    "short_name": "Faraway",
    "description": "Application de gestion de scores et détection automatique de cartes par IA pour le jeu Faraway",
    "start_url": "/",
    "scope": "/",
    "icons": [
        {
            "src": "/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "theme_color": "#4f46e5",
    "background_color": "#1e1b4b",
    "display": "standalone",
    "orientation": "portrait",
    "categories": ["games", "utilities", "productivity"],
    "lang": "fr-FR",
    "dir": "ltr",
    "prefer_related_applications": false,
    "display_override": ["standalone", "minimal-ui"],
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "edge_side_panel": {},
    "shortcuts": [
        {
            "name": "Détecter des cartes",
            "short_name": "Détection",
            "description": "Lancer la détection de cartes par IA",
            "url": "/image-detector",
            "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
        },
        {
            "name": "Voir les scores",
            "short_name": "Scores",
            "description": "Consulter les scores de la partie",
            "url": "/score",
            "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192" }]
        }
    ]
}